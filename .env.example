# Copy to .env (never commit .env). Real values go in hosting dashboards.

# --- apps/agent (server only) ---
QLOO_API_KEY=            # your own event-issued Qloo key (server secret)
# Hackathon keys only work against the hackathon API (Qloo kickoff email). Not secret.
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_TRUSTED_BASE_URL=https://hackathon.api.qloo.com
LLM_API_KEY=             # optional: OpenAI-compatible API key for the LLM steps (server secret)
LLM_MODEL=gpt-6-luna     # any model your provider offers with structured outputs
# LLM_BASE_URL=https://api.openai.com/v1   # or another OpenAI-compatible endpoint (https only)
# LLM_REASONING_EFFORT=low                 # none | low | medium | high ("none" for non-OpenAI)
LLM_DAILY_CALLS=400      # live LLM calls per UTC day; cache hits do not count
DATABASE_URL=            # postgres://... (Neon/Supabase)
WEB_ORIGIN=http://localhost:3000   # CORS allow-list
DAILY_QLOO_CALL_BUDGET=500      # live Qloo calls per UTC day; cache hits do not count
QLOO_CACHE_TTL_DAYS=7           # cache lifetime for user profiles (demo personas never expire)
PORT=8787
TRUST_PROXY_HOPS=0       # reverse proxies in front of the agent (not used on Render)
# CLIENT_IP_HEADER=cf-connecting-ip  # Render: the edge sets the real client IP here (see render.yaml)
# QLOO_MCP_COMMAND=qloo  # optional: full path to the qloo binary if it is not on PATH

# --- apps/web (public, NO secrets here) ---
# Next.js only reads env files in its own folder: put this in apps/web/.env.local (or Vercel env).
NEXT_PUBLIC_AGENT_URL=http://localhost:8787
