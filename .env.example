# Copy to .env (never commit .env). Real values go in hosting dashboards.

# --- apps/agent (server only) ---
QLOO_API_KEY=            # your own event-issued Qloo key (server secret)
# Hackathon keys only work against the hackathon API (Qloo kickoff email). Not secret.
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_TRUSTED_BASE_URL=https://hackathon.api.qloo.com
ANTHROPIC_API_KEY=       # Anthropic Console API key for the app's own LLM calls (server secret)
ANTHROPIC_MODEL=claude-sonnet-5-5
DATABASE_URL=            # postgres://... (Neon/Supabase)
WEB_ORIGIN=http://localhost:3000   # CORS allow-list
DAILY_QLOO_CALL_BUDGET=500
DAILY_LLM_TOKEN_BUDGET=2000000
PORT=8787
TRUST_PROXY_HOPS=0       # reverse proxies in front of the agent (Render: 2)
# QLOO_MCP_COMMAND=qloo  # optional: full path to the qloo binary if it is not on PATH

# --- apps/web (public, NO secrets here) ---
# Next.js only reads env files in its own folder: put this in apps/web/.env.local (or Vercel env).
NEXT_PUBLIC_AGENT_URL=http://localhost:8787
