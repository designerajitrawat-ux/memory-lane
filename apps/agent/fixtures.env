# Local demo mode (no secrets): in-memory Postgres + synthetic Qloo answers from test/fixtures.
# Both settings are refused in production. Run: pnpm --filter @memory-lane/agent dev:fixtures
# Committed on purpose: never put keys or real database URLs in this file.
DATABASE_URL=pglite:memory
QLOO_FIXTURE_DIR=test/fixtures
WEB_ORIGIN=http://localhost:3000
